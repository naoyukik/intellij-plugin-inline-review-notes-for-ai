<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.naoyukik.intellijplugininlinereviewnotesforai</id>
    <name>Inline Review Notes for AI</name>
    <vendor>naoyukik</vendor>
    <resource-bundle>messages.MyBundle</resource-bundle>
    <description><![CDATA[
        <p><b>Inline Review Notes for AI</b> allows you to add and manage inline review comments for your local files.</p>
        <p>Comments are stored as JSON files on a per-branch basis in the <code>.inline-review-notes/</code> directory, making them easy for AI tools to read and process without cluttering your source code.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <applicationListeners>
        <listener class="com.github.naoyukik.intellijplugininlinereviewnotesforai.editor.ReviewCommentEditorFactoryListener" topic="com.intellij.openapi.editor.event.EditorFactoryListener"/>
        <listener class="com.github.naoyukik.intellijplugininlinereviewnotesforai.editor.ReviewCommentEditorFileListener" topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </applicationListeners>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.github.naoyukik.intellijplugininlinereviewnotesforai.editor.ReviewCommentEditorProjectActivity"/>
        <projectService serviceImplementation="com.github.naoyukik.intellijplugininlinereviewnotesforai.editor.RangeMarkerManager"/>
        <notificationGroup id="Inline Review Notes"
                           displayType="BALLOON"
                           isLogByDefault="false"/>
    </extensions>

    <actions>
        <action id="AddReviewCommentAction"
                class="com.github.naoyukik.intellijplugininlinereviewnotesforai.action.AddReviewCommentAction"
                text="%action.AddReviewCommentAction.text"
                description="%action.AddReviewCommentAction.description">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
    </actions>

</idea-plugin>
